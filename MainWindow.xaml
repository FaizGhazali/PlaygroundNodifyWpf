<Window x:Class="PlaygroundNodifyWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xen="clr-namespace:XenNodify;assembly=XenNodify"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlaygroundNodifyWpf"
        xmlns:helper="clr-namespace:PlaygroundNodifyWpf.Helper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <helper:BindingProxy x:Key="MainProxy" DataContext="{Binding}" />
        <helper:BoolToVisibilityConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    <Grid>
        <xen:XenNodifyWorkspace  x:Name="xenNodify" PointerPosition="{Binding MousePosition, Mode=TwoWay}" IsHitTestVisible="{Binding IsUpdating, Converter={StaticResource InverseBoolConverter}}" PreviewMouseDown="xenNodify_PreviewMouseDown" >
            <xen:XenNodifyWorkspace.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add Node" Command="{Binding DataContext.AddNodeCommand,Source={StaticResource MainProxy}}"/>
                    <MenuItem Header="Add Rectangle Node" Command="{Binding DataContext.AddRectangleNodeCommand,Source={StaticResource MainProxy}}"/>
                    <MenuItem Header="Add Circle Node" Command="{Binding DataContext.AddCircleNodeCommand,Source={StaticResource MainProxy}}"/>
                    <MenuItem Header="Delete Node" Command="{Binding DataContext.DeleteNodeCommand,Source={StaticResource MainProxy}}"/>
                </ContextMenu>
            </xen:XenNodifyWorkspace.ContextMenu>
        </xen:XenNodifyWorkspace>
    </Grid>
</Window>
