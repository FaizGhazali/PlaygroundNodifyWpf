<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Nodify" Version="7.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="XenNodify">
      <HintPath>..\PlaygroundNodifyService\bin\Debug\net8.0-windows\XenNodify.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
